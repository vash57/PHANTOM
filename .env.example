# PHANTOM.exe configuration.
# Copy this file to .env and edit the values you need.
# Process environment variables override values in .env.

# Local Ollama endpoint. No API key is required.
OLLAMA_BASE_URL=http://localhost:11434

# The model PHANTOM speaks through.
# gemma4:e2b is the intended default; if your Ollama installation does not
# have that tag, set this to any installed model (see `ollama list`).
OLLAMA_MODEL=gemma4:e2b

# phantom | wraith | oracle | nightmare
PHANTOM_PERSONALITY=phantom

# true / false. Set to false for a completely still terminal.
PHANTOM_ANIMATION=true

# 0.1 to 10.0; lower is slower.
PHANTOM_ANIMATION_SPEED=1.0

# Local JSON session directory. Relative paths are resolved from the
# directory where you run PHANTOM.
PHANTOM_MEMORY_DIR=data/sessions
